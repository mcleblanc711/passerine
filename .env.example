# Copy to .env; this file is sourced by run-local.sh. Keep shell values quoted.
PASSERINE_PASSWORD='replace-with-a-long-private-password'
PASSERINE_ORIGIN='http://127.0.0.1:8000'
PASSERINE_SECURE_COOKIE=0
PASSERINE_DB='runtime/passerine.sqlite3'
# Set DEMO=1 and use a different DB for synthetic data. Never mix origins in one DB.
PASSERINE_DEMO=0
PASSERINE_WETHR_DB='/home/cleblanc/projects/wethr/data/wethr.db'
PASSERINE_WJ_ROOT='/home/cleblanc/projects/whiskeyjack-bot'
PASSERINE_WJ_DB='/home/cleblanc/projects/whiskeyjack-bot/data/whiskeyjack_bot.sqlite3'
